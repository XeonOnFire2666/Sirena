<UserControl x:Class="SirenaDesktop.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SirenaDesktop.Presentation.Converters"
             xmlns:viewModels="clr-namespace:SirenaDesktop.ViewModels"
             xmlns:models="clr-namespace:SirenaDesktop.Core.Models;assembly=SirenaDesktop.Core"
             xmlns:coreInterfaces="clr-namespace:SirenaDesktop.Core.Interfaces;assembly=SirenaDesktop.Core"
             xmlns:views="clr-namespace:SirenaDesktop.Views"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="15"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <converters:SafeImageSourceConverter x:Key="SafeImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:IconTypeConverter x:Key="IconTypeConverter" />
        <converters:BoolToGitIconConverter x:Key="BoolToGitIconConverter" />
        <converters:BoolToGitBrushConverter x:Key="BoolToGitBrushConverter" />
        <converters:BoolToKeyStatusIconConverter x:Key="BoolToKeyStatusIconConverter" />

        <DataTemplate DataType="{x:Type viewModels:HomeTabViewModel}">
            <views:HomeTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ActivityTabViewModel}">
            <views:ActivityTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TodoTabViewModel}">
            <views:DayPlanTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TimerTabViewModel}">
            <views:TimerTabView />
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceTypeCardTemplate" DataType="{x:Type models:WorkspaceType}">
            <materialDesign:Card Margin="0,0,0,10" Padding="16,14" UniformCornerRadius="8"
                                 Style="{StaticResource MaterialDesignOutlinedCard}"
                                 Cursor="Hand">
                <materialDesign:Card.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.PickWorkspaceTypeCommand, ElementName=WorkspaceDialogRoot}"
                                  CommandParameter="{Binding}" />
                </materialDesign:Card.InputBindings>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconTypeConverter}}"
                                             Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <materialDesign:DialogHost IsOpen="{Binding IsProfileDialogOpen}"
                                   CloseOnClickAway="True"
                                   OverlayBackground="{DynamicResource MaterialDesign.Brush.SurfaceContainerLowest}">

            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="400" UniformCornerRadius="8" Padding="24"
                                     Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}">
                    <StackPanel>
                        <TextBlock Text="Аккаунт"
                                   Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border CornerRadius="8" ClipToBounds="True" Width="48" Height="48"
                                    Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountCircle" Width="36" Height="36"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image
                                        Source="{Binding UserPictureUrl, Converter={StaticResource SafeImageSourceConverter}}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding UserName, FallbackValue='Загрузка...'}"
                                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{DynamicResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Command="{Binding LogoutCommand}"
                                Background="{DynamicResource MaterialDesign.Brush.Error}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Error}"
                                Foreground="{DynamicResource MaterialDesign.Brush.OnError}"
                                Content="Выйти из аккаунта"
                                HorizontalAlignment="Stretch"
                                Height="40" />

                        <Button Margin="0,16,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Content="Закрыть"
                                Command="{Binding CloseProfileCommand}"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>

            <materialDesign:DialogHost IsOpen="{Binding IsSettingsDialogOpen}"
                                       CloseOnClickAway="True"
                                       OverlayBackground="{DynamicResource MaterialDesign.Brush.SurfaceContainerLowest}">

                <materialDesign:DialogHost.DialogContent>
                    <materialDesign:Card Width="400" UniformCornerRadius="8" Padding="24"
                                         Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}">
                        <StackPanel>
                            <TextBlock Text="Настройки"
                                       Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20" />

                            <StackPanel Margin="0,10,0,24">
                                <TextBlock Text="Git-репозиторий"
                                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBlock
                                    Text="Локальная папка проекта для отслеживания коммитов и начисления доп. баллов для процента продуктивности"
                                    Style="{DynamicResource MaterialDesignBodySmallTextBlock}"
                                    Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,16" />

                                <materialDesign:Card UniformCornerRadius="8" Padding="14"
                                                     Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                                     Style="{StaticResource MaterialDesignOutlinedCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="{Binding GitSettings.IsRepoValid, Converter={StaticResource BoolToGitIconConverter}}"
                                                                 Width="24" Height="24"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 Foreground="{Binding GitSettings.IsRepoValid, Converter={StaticResource BoolToGitBrushConverter}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding GitSettings.RepoDisplayName, FallbackValue='Репозиторий не выбран', TargetNullValue='Репозиторий не выбран'}"
                                                FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="{Binding GitSettings.RepoPath}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding GitSettings.RepoPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding GitSettings.StatusMessage}"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{Binding GitSettings.IsRepoValid, Converter={StaticResource BoolToGitBrushConverter}}"
                                                       Visibility="{Binding GitSettings.StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32"
                                                Command="{Binding GitSettings.ClearRepoCommand}"
                                                ToolTip="Отключить репозиторий"
                                                Visibility="{Binding GitSettings.RepoPath, Converter={StaticResource NullToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                </materialDesign:Card>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Content="Выбрать папку репозитория"
                                        Command="{Binding GitSettings.BrowseRepoCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Height="38" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Gemini API ключ"
                                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Ключ хранится локально в защищённом локальном хранилище"
                                           Style="{DynamicResource MaterialDesignBodySmallTextBlock}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Kind="{Binding ApiKeySettings.HasSavedKey, Converter={StaticResource BoolToKeyStatusIconConverter}}"
                                        Width="18" Height="18"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiKeySettings.HasSavedKey}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Ключ сохранён" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ApiKeySettings.HasSavedKey}"
                                                                 Value="False">
                                                        <Setter Property="Text" Value="Ключ не задан" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             materialDesign:HintAssist.Hint="Введите API ключ"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                             Margin="0,0,0,12">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox"
                                               BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ApiKeySettings.IsInvalid}" Value="True">
                                                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush"
                                                            Value="{DynamicResource MaterialDesign.Brush.Error}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource MaterialDesign.Brush.Error}" />
                                                    <Setter Property="materialDesign:HintAssist.Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Удалить ключ"
                                            Command="{Binding ApiKeySettings.DeleteApiKeyCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                                            Visibility="{Binding ApiKeySettings.HasSavedKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Сохранить"
                                            Command="{Binding ApiKeySettings.SaveApiKeyCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>

                                <TextBlock Text="{Binding ApiKeySettings.StatusMessage}"
                                           Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ApiKeySettings.StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Content="Закрыть"
                                    Command="{Binding CloseSettingsCommand}"
                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </materialDesign:Card>
                </materialDesign:DialogHost.DialogContent>

                <materialDesign:DialogHost
                    IsOpen="{Binding SelectedTab.IsAnyDialogOpen, Mode=OneWay, FallbackValue=False}"
                    CloseOnClickAway="False"
                    DialogClosing="TaskOrWorkspaceDialogHost_DialogClosing"
                    OverlayBackground="{DynamicResource MaterialDesign.Brush.SurfaceContainerLowest}">

                    <materialDesign:DialogHost.DialogContent>
                        <ContentControl Content="{Binding SelectedTab}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type viewModels:TodoTabViewModel}">
                                    <Grid x:Name="WorkspaceDialogRoot">
                                        <materialDesign:Card Width="420" UniformCornerRadius="8" Padding="24"
                                                             Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}"
                                                             Visibility="{Binding IsWorkspaceDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>

                                                <StackPanel
                                                    Visibility="{Binding IsPickingWorkspaceType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Новое пространство"
                                                               Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="Выберите тип рабочего пространства на сегодня"
                                                               Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                               Margin="0,0,0,20" />

                                                    <ItemsControl ItemsSource="{Binding AvailableWorkspaceTypes}"
                                                                  ItemTemplate="{StaticResource WorkspaceTypeCardTemplate}" />

                                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                            materialDesign:ButtonAssist.CornerRadius="8"
                                                            Content="Отмена"
                                                            Command="{Binding CancelWorkspaceDialogCommand}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0" />
                                                </StackPanel>

                                                <StackPanel
                                                    Visibility="{Binding IsNamingWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Название пространства"
                                                               Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock
                                                        Text="{Binding PendingWorkspaceType.Title, StringFormat='Тип: {0}'}"
                                                        Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                        Margin="0,0,0,20" />

                                                    <TextBox
                                                        Text="{Binding NewWorkspaceNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                        materialDesign:HintAssist.Hint="Название"
                                                        materialDesign:TextFieldAssist.HasClearButton="True"
                                                        MaxLength="60" />

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                Margin="0,20,0,0">
                                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                                Content="Назад"
                                                                Command="{Binding BackToTypePickerCommand}"
                                                                Margin="0,0,8,0" />
                                                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                                Content="Создать"
                                                                Command="{Binding ConfirmCreateWorkspaceCommand}" />
                                                    </StackPanel>
                                                </StackPanel>

                                            </StackPanel>
                                        </materialDesign:Card>

                                        <materialDesign:Card Width="350" UniformCornerRadius="8" Padding="24"
                                                             Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}"
                                                             Visibility="{Binding IsDeleteWorkspaceDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Удалить пространство?"
                                                           Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                                           FontWeight="Bold" Margin="0,0,0,8" />

                                                <TextBlock
                                                    Text="Вы уверены, что хотите удалить это пространство? Все задачи внутри будут безвозвратно удалены."
                                                    TextWrapping="Wrap"
                                                    Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                    Margin="0,0,0,24" />

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                            materialDesign:ButtonAssist.CornerRadius="8"
                                                            Content="Отмена"
                                                            Command="{Binding CancelDeleteWorkspaceDialogCommand}"
                                                            Margin="0,0,8,0" />

                                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                            materialDesign:ButtonAssist.CornerRadius="8"
                                                            Background="{DynamicResource MaterialDesign.Brush.Error}"
                                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Error}"
                                                            Foreground="{DynamicResource MaterialDesign.Brush.OnError}"
                                                            Content="Удалить"
                                                            Command="{Binding ConfirmDeleteWorkspaceCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </materialDesign:Card>

                                        <materialDesign:Card Width="400" UniformCornerRadius="8" Padding="24"
                                                             Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}"
                                                             Visibility="{Binding IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DialogTitle}"
                                                           Style="{DynamicResource MaterialDesignTitleLargeTextBlock}"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,20" />
                                                <TextBox
                                                    Text="{Binding TaskTitleInput, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    materialDesign:HintAssist.Hint="Что нужно сделать?"
                                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                                    MaxLength="100"
                                                    Margin="0,0,0,20" />

                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:TimePicker Grid.Column="0"
                                                                               SelectedTime="{Binding TaskStartTimeInput}"
                                                                               Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                                                                               materialDesign:HintAssist.Hint="Время начала">
                                                        <materialDesign:TimePicker.Resources>
                                                            <Style TargetType="materialDesign:Clock"
                                                                   BasedOn="{StaticResource {x:Type materialDesign:Clock}}">
                                                                <Setter Property="Is24Hours" Value="True" />
                                                            </Style>
                                                        </materialDesign:TimePicker.Resources>
                                                    </materialDesign:TimePicker>

                                                    <materialDesign:TimePicker Grid.Column="2"
                                                                               SelectedTime="{Binding TaskEndTimeInput}"
                                                                               Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                                                                               materialDesign:HintAssist.Hint="Время конца">
                                                        <materialDesign:TimePicker.Resources>
                                                            <Style TargetType="materialDesign:Clock"
                                                                   BasedOn="{StaticResource {x:Type materialDesign:Clock}}">
                                                                <Setter Property="Is24Hours" Value="True" />
                                                            </Style>
                                                        </materialDesign:TimePicker.Resources>
                                                    </materialDesign:TimePicker>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Margin="0,8,0,0">
                                                    <Button Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            materialDesign:ButtonAssist.CornerRadius="8"
                                                            Content="Отмена"
                                                            Command="{Binding CancelDialogCommand}" />

                                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                            materialDesign:ButtonAssist.CornerRadius="8"
                                                            Content="Сохранить"
                                                            Command="{Binding SaveTaskCommand}"
                                                            Margin="12,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </materialDesign:DialogHost.DialogContent>

                    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileDialogOpen}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="16" KernelType="Gaussian"
                                                            RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSettingsDialogOpen}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="16" KernelType="Gaussian"
                                                            RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.IsAnyDialogOpen, FallbackValue=False}"
                                                 Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="16" KernelType="Gaussian"
                                                            RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStreakCelebrationVisible}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="16" KernelType="Gaussian"
                                                            RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="0,8,8,0"
                                ClipToBounds="True" />

                        <Grid Grid.Column="0" Margin="4,20,4,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Viewbox Grid.Row="0" Width="26" Height="26" Margin="0,0,0,20">
                                <materialDesign:PackIcon Kind="Wheelchair"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Viewbox>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Tabs}"
                                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                     HorizontalContentAlignment="Center"
                                     VerticalAlignment="Top"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,8" />
                                        <Setter Property="Margin" Value="0,3" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type coreInterfaces:ITabViewModel}">
                                        <materialDesign:PackIcon
                                            Kind="{Binding Icon, Converter={StaticResource IconTypeConverter}}"
                                            Width="22" Height="22"
                                            ToolTip="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32"
                                        Command="{Binding OpenSettingsCommand}"
                                        Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                        ToolTip="Настройки"
                                        Margin="0,0,0,0">
                                    <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" />
                                </Button>

                                <Button Command="{Binding OpenProfileCommand}"
                                        Width="32" Height="32"
                                        Margin="0,14,0,0"
                                        Padding="0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        ToolTip="{Binding UserName, FallbackValue='Загрузка...'}">
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="8"
                                                Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}">
                                            <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </Border>
                                        <Border CornerRadius="8" ClipToBounds="True">
                                            <Image
                                                Source="{Binding UserPictureUrl, Converter={StaticResource SafeImageSourceConverter}}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ContentControl Grid.Column="1" Content="{Binding SelectedTab}" />
                    </Grid>
                </materialDesign:DialogHost>
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>

        <Grid x:Name="StreakOverlay"
              Visibility="{Binding IsStreakCelebrationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#66000000"
              MouseLeftButtonDown="StreakOverlay_MouseLeftButtonDown">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStreakCelebrationVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerHigh}"
                    CornerRadius="8"
                    Width="320" Height="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{DynamicResource MaterialDesignShadowDepth3}">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="CardTranslate" Y="40" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 From="40" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Viewbox Width="88" Height="88" Margin="0,0,0,16">
                        <materialDesign:PackIcon x:Name="FireIcon"
                                                 Kind="Fire"
                                                 Foreground="#FF6D00"
                                                 RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <ScaleTransform x:Name="FireScale" ScaleX="0" ScaleY="0" />
                            </materialDesign:PackIcon.RenderTransform>
                            <materialDesign:PackIcon.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FireScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0" To="1" Duration="0:0:0.4"
                                                             BeginTime="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FireScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0" To="1" Duration="0:0:0.4"
                                                             BeginTime="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </materialDesign:PackIcon.Triggers>
                        </materialDesign:PackIcon>
                    </Viewbox>

                    <TextBlock Text="Серия продлена!"
                               Style="{DynamicResource MaterialDesignHeadlineSmallTextBlock}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding CelebratedStreak, StringFormat='Уже {0} дней подряд 🔥'}"
                               Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <Button Content="Отлично!"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Command="{Binding CloseStreakCelebrationCommand}"
                            HorizontalAlignment="Center"
                            Width="140" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>