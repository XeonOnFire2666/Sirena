<UserControl x:Class="SirenaDesktop.Views.HomeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:SirenaDesktop.Presentation.Converters">


    <UserControl.Resources>
        <converters:IconTypeConverter x:Key="IconTypeConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,40,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Анализ активности" Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                           FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Детализированная хронология работы за текущие сутки"
                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}" Margin="0,6,0,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
            </StackPanel>

            <materialDesign:Card Grid.Row="1"
                                 Style="{StaticResource MaterialDesignElevatedCard}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 UniformCornerRadius="8"
                                 Padding="24"
                                 Margin="0,0,0,32">
                <StackPanel>

                    <Border CornerRadius="8" ClipToBounds="True" MinHeight="320" HorizontalAlignment="Stretch"
                            Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                            Padding="16,16,16,12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid.Resources>

                                <Style x:Key="VisibleIfNoData" TargetType="FrameworkElement">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding ChartTitle}"
                                           Style="{DynamicResource MaterialDesignTitleMediumTextBlock}"
                                           FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        Height="32"
                                        Width="140"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource MaterialDesign.Brush.Outline}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Margin" Value="-1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                                Style="{StaticResource MaterialDesignDatePicker}"
                                                BorderThickness="0"
                                                Padding="10,0,0,0"
                                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                                materialDesign:TextFieldAssist.HasClearButton="False"
                                                materialDesign:HintAssist.IsFloating="False"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding TogglePlatformCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32"
                                        Padding="12,0"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Kind="{Binding PlatformIcon, Converter={StaticResource IconTypeConverter}}"
                                            Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PlatformButtonText}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Grid Grid.Column="2">
                                    <Button x:Name="FilterButton"
                                            Command="{Binding OpenFilterPopupCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="32" Padding="12,0"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterVariant" Margin="0,0,6,0"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FilterButtonText}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Popup IsOpen="{Binding IsFilterPopupOpen}"
                                           PlacementTarget="{Binding ElementName=FilterButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <materialDesign:Card UniformCornerRadius="8" Padding="4" MinWidth="220"
                                                             materialDesign:ElevationAssist.Elevation="Dp4">
                                            <Grid>
                                                <StackPanel
                                                    Visibility="{Binding IsShowingTodoStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <Button Content="Весь день"
                                                            Command="{Binding PickWorkspaceInPopupCommand}"
                                                            CommandParameter="{x:Null}"
                                                            HorizontalContentAlignment="Left"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                    <Separator />
                                                    <ItemsControl ItemsSource="{Binding TotalWorkspaces}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Name}"
                                                                        Command="{Binding DataContext.PickWorkspaceInPopupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Left"
                                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <StackPanel
                                                    Visibility="{Binding IsShowingTodoStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Content="← Назад"
                                                            Command="{Binding BackToWorkspaceStepCommand}"
                                                            HorizontalContentAlignment="Left"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                    <Separator />
                                                    <ItemsControl ItemsSource="{Binding TotalTodo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Title}"
                                                                        Command="{Binding DataContext.PickTodoInPopupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Left"
                                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </materialDesign:Card>
                                    </Popup>
                                </Grid>
                            </Grid>

                            <lvc:CartesianChart Grid.Row="2"
                                                Series="{Binding Pr}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                Background="Transparent"
                                                TooltipPosition="Top"
                                                TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                                TooltipTextPaint="{Binding TooltipTextPaint}"
                                                LegendPosition="Hidden"
                                                AnimationsSpeed="0:0:0.5"
                                                Margin="0" Padding="0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <lvc:CartesianChart.Style>
                                    <Style TargetType="lvc:CartesianChart">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </lvc:CartesianChart.Style>
                            </lvc:CartesianChart>

                            <StackPanel Grid.Row="2"
                                        Style="{StaticResource VisibleIfNoData}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,20,0,0">
                                <materialDesign:PackIcon Kind="DatabaseOffOutline" Width="48" Height="48"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                         Opacity="0.5" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding EmptyDataMessage}"
                                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <UniformGrid Grid.Row="2" Columns="3">
                <materialDesign:Card Style="{StaticResource MaterialDesignOutlinedCard}" UniformCornerRadius="8"
                                     Margin="0,0,12,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Всего зафиксировано"
                                   Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding TotalTrackedTimeStr}"
                                   Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}" FontSize="24"
                                   FontWeight="Black" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource MaterialDesignOutlinedCard}" UniformCornerRadius="8"
                                     Margin="12,0,12,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Продуктивность" Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding ProductivityPercent, StringFormat='{}{0}%'}"
                                   Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}" FontSize="24"
                                   FontWeight="Black" Foreground="MediumSeaGreen" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource MaterialDesignOutlinedCard}" UniformCornerRadius="8"
                                     Margin="12,0,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Приложения / Сайты"
                                   Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding TotalUniqueApps, StringFormat='{}{0}'}"
                                   Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}" FontSize="24"
                                   FontWeight="Black" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>