<UserControl x:Class="SirenaDesktop.Views.TimerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:SirenaDesktop.Core.Models;assembly=SirenaDesktop.Core"
             xmlns:vm="clr-namespace:SirenaDesktop.ViewModels"
             xmlns:conv="clr-namespace:SirenaDesktop.Presentation.Converters">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <conv:TimeSpanToMinutesConverter x:Key="TimeSpanToMinutesConverter" />

        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar"
               BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="HistoryRailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailBorder"
                                Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                                CornerRadius="8,0,0,8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Grid Background="Transparent">
                                <StackPanel x:Name="RailContent"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="IconTransform" X="0" />
                                    </StackPanel.RenderTransform>
                                    <materialDesign:PackIcon x:Name="ChevronIcon"
                                                             Kind="ChevronLeft"
                                                             Width="18" Height="18"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                             HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="-3" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="HistoryPanelColumn" Width="40" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,40,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Таймер"
                               Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                               FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="24"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    MaxWidth="480">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,8">

                    <TextBlock Text="{Binding RemainingText}"
                               FontSize="96" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="Manrope" />

                    <Separator Width="140" Margin="0,8,0,20"
                               Background="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />

                    <Border CornerRadius="8" ClipToBounds="True"
                            Width="320" Height="8"
                            Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTicking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Style="{StaticResource RoundedProgressBar}" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,32">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Content="-1:00" Command="{Binding SubtractOneMinCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Margin="0,0,12,0" Padding="18,8" />

                        <Button Content="+1:00" Command="{Binding AddOneMinCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Padding="18,8" />
                    </StackPanel>

                    <Grid HorizontalAlignment="Stretch" Width="320">
                        <Button Content="{materialDesign:PackIcon Kind=Play, Size=24}"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="52" materialDesign:ButtonAssist.CornerRadius="8">
                            <Button.Visibility>
                                <Binding Path="IsIdle" Converter="{StaticResource BooleanToVisibilityConverter}" />
                            </Button.Visibility>
                        </Button>

                        <UniformGrid Columns="2" Rows="1">
                            <UniformGrid.Visibility>
                                <Binding Path="IsRunning" Converter="{StaticResource BooleanToVisibilityConverter}" />
                            </UniformGrid.Visibility>
                            <Button Content="{materialDesign:PackIcon Kind=Pause, Size=24}"
                                    Command="{Binding PauseCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="52" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="8" />
                            <Button Content="{materialDesign:PackIcon Kind=Restore, Size=24}"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="52" Margin="6,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="8" />
                        </UniformGrid>

                        <UniformGrid Columns="2" Rows="1">
                            <UniformGrid.Visibility>
                                <Binding Path="IsPaused" Converter="{StaticResource BooleanToVisibilityConverter}" />
                            </UniformGrid.Visibility>
                            <Button Content="{materialDesign:PackIcon Kind=Play, Size=24}"
                                    Command="{Binding StartCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="52" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="8" />
                            <Button Content="{materialDesign:PackIcon Kind=Restore, Size=24}"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="52" Margin="6,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="8" />
                        </UniformGrid>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1"
                Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                CornerRadius="8,0,0,8"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.12" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="RailButton"
                        Grid.Row="0" Grid.RowSpan="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Command="{Binding ToggleHistoryPanelCommand}"
                        ToolTip="Показать/скрыть историю">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HistoryRailButtonStyle}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryCollapsed}" Value="False">
                                    <Setter Property="Width" Value="40" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Row="0" Margin="44,40,20,16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Запись концентрации"
                               Style="{DynamicResource MaterialDesignTitleMediumTextBlock}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="44,0,12,32"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding HistoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimerHistoryGroup}">
                                <StackPanel Margin="0,0,0,20">

                                    <TextBlock Text="{Binding DateLabel}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                               Margin="2,0,0,12" />

                                    <ItemsControl ItemsSource="{Binding Sessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TimerSession}">
                                                <Grid Background="Transparent" Height="38">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Separator Grid.Column="0"
                                                               Width="1.5"
                                                               Background="{DynamicResource MaterialDesign.Brush.OutlineVariant}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Stretch"
                                                               Margin="0" />

                                                    <Border Grid.Column="0"
                                                            Width="14" Height="14"
                                                            CornerRadius="8"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="#2A1B40"
                                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                                            BorderThickness="1.5">
                                                        <materialDesign:PackIcon Kind="Circle"
                                                                Width="4" Height="4"
                                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurface}"
                                                               Opacity="0.9">
                                                        <Run Text="{Binding StartedAt, StringFormat='HH:mm'}" />
                                                        <Run Text=" - " />
                                                        <Run
                                                            Text="{Binding EndedAt, StringFormat='HH:mm', TargetNullValue='...'}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding PlannedDuration, Converter={StaticResource TimeSpanToMinutesConverter}}"
                                                               Margin="0,0,6,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>