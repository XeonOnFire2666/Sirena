<UserControl x:Class="SirenaDesktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             FontFamily="pack://application:,,,/Fonts/#Manrope">
    <Grid>
        <Border Background="{DynamicResource MaterialDesign.Brush.PrimaryContainer}" Opacity="0.15" />

        <materialDesign:Card x:Name="Cli"
                             UniformCornerRadius="8"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Width="280"
                             Padding="24"
                             Height="340">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Sirena"
                               Style="{DynamicResource MaterialDesignHeadline4TextBlock}"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,0,4"
                               Foreground="Black" />

                    <TextBlock Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                               FontFamily="Druk Wide Bold"
                               Name="RedbullLabel"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignShadowBrush}">
                        <Run Text="Redbull окрыляет" />
                    </TextBlock>
                </StackPanel>

                <materialDesign:PackIcon Grid.Row="1"
                                         Kind="Wheelchair"
                                         Width="72"
                                         Height="72"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                <Button Grid.Row="2"
                        x:Name="GoogleLoginButton"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="50"
                        Command="{Binding GoogleLoginCommand}"
                        AutomationProperties.Name="LoginByGoogleButton">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Google" Width="22" Height="22" VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <TextBlock Text="Войти через Google"
                                   Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>