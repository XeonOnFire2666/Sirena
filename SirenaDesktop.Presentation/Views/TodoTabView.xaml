<UserControl x:Class="SirenaDesktop.Views.DayPlanTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:SirenaDesktop.ViewModels"
             xmlns:models="clr-namespace:SirenaDesktop.Core.Models;assembly=SirenaDesktop.Core"
             xmlns:converters="clr-namespace:SirenaDesktop.Presentation.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:IconTypeConverter x:Key="IconTypeConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <DataTemplate x:Key="WeekDayTemplate" DataType="{x:Type models:WeekDayItem}">
            <Button Command="{Binding DataContext.SelectDayCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Padding="14,8" Margin="2,0"
                    materialDesign:ButtonAssist.CornerRadius="8">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DayOfWeekShort}" FontSize="14" VerticalAlignment="Center"
                               FontWeight="Medium">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="Medium"
                               Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnSurface}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceCardTemplate" DataType="{x:Type viewModels:WorkspaceCardItem}">
            <Border Width="180" Height="140" Margin="0,0,16,16" CornerRadius="8"
                    Background="{Binding Background}"
                    Tag="{Binding DataContext, ElementName=Root}"
                    Cursor="Hand">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Удалить пространство"
                                  Command="{Binding PlacementTarget.Tag.OpenDeleteWorkspaceDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Foreground="{DynamicResource MaterialDesign.Brush.Error}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="DeleteOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenWorkspaceCommand, ElementName=Root}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black" />
                </Border.Effect>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:PackIcon Grid.Row="0"
                                             Kind="{Binding Icon, Converter={StaticResource IconTypeConverter}}"
                                             Width="26" Height="26"
                                             Foreground="Black" Opacity="0.65"
                                             HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                               Foreground="Black" TextWrapping="Wrap"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Text="{Binding ProgressText}" FontSize="12"
                               Foreground="Black" Opacity="0.65"
                               HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceTypeCardTemplate" DataType="{x:Type models:WorkspaceType}">
            <materialDesign:Card Margin="0,0,0,10" UniformCornerRadius="8"
                                 Style="{StaticResource MaterialDesignOutlinedCard}"
                                 ClipToBounds="True">
                <Button Command="{Binding DataContext.PickWorkspaceTypeCommand, ElementName=WorkspaceDialogRoot}"
                        CommandParameter="{Binding}"
                        Padding="16,14"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{Binding Icon, Converter={StaticResource IconTypeConverter}}"
                                                 Width="28" Height="28"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                 VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </materialDesign:Card>
        </DataTemplate>

        <DataTemplate x:Key="TodoItemTemplate" DataType="{x:Type models:TodoItem}">
            <materialDesign:Card Margin="0,4,0,8" Padding="16,12" UniformCornerRadius="8"
                                 Style="{StaticResource MaterialDesignElevatedCard}"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Command="{Binding DataContext.CompleteTaskCommand, ElementName=Root}"
                              CommandParameter="{Binding}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasDeadline, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DueDateTimeText}" FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38"
                                Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                Command="{Binding DataContext.OpenEditDialogCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="Редактировать">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="38" Height="38"
                                Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                                Command="{Binding DataContext.DeleteTaskCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="Удалить задачу" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,40,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsWorkspaceOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Width="40" Height="40" Margin="-8,0,4,0"
                            Command="{Binding CloseWorkspaceCommand}"
                            ToolTip="Назад к пространствам">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24" />
                    </Button>
                    <Button Command="{Binding CloseWorkspaceCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="8,0" HorizontalContentAlignment="Left">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                                   FontSize="28" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>

                <TextBlock Text="План дня"
                           Visibility="{Binding IsWorkspaceGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                           FontSize="28" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyLargeTextBlock}">
                            <Setter Property="Text" Value="Ваши пространства на день" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceOpen}" Value="True">
                                    <Setter Property="Text" Value="Ваш персональный список задач" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="8"
                    Command="{Binding OpenAddDialogCommand}"
                    Visibility="{Binding IsWorkspaceOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Width="48" Height="48"
                    Padding="0"
                    Margin="16,0,0,0">
                <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" />
            </Button>
        </Grid>

        <materialDesign:Card Grid.Row="1" Margin="0,0,0,20" UniformCornerRadius="8" Padding="8,10"
                             Style="{StaticResource MaterialDesignOutlinedCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                        Width="32" Height="32"
                        Command="{Binding PrevWeekCommand}"
                        ToolTip="Предыдущая неделя">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" />
                </Button>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}"
                              ItemTemplate="{StaticResource WeekDayTemplate}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                        Width="32" Height="32"
                        Command="{Binding NextWeekCommand}"
                        ToolTip="Следующая неделя">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsWorkspaceGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding WorkspaceCards}"
                                  ItemTemplate="{StaticResource WorkspaceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Width="180" Height="140" Margin="0,0,16,16" CornerRadius="8"
                            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OpenCreateWorkspaceDialogCommand}" />
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Plus" Width="28" Height="28"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                     HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Добавить" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>

            <Grid Visibility="{Binding IsWorkspaceOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsTasksEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="64" Height="64"
                                             Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                             HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Задач пока нет" Style="{DynamicResource MaterialDesignTitleMediumTextBlock}"
                               Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              IsHitTestVisible="{Binding IsTasksEmpty, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TodoItemTemplate}" />

                        <StackPanel Margin="0,40,0,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllTasksCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0"
                                                                         To="1" Duration="0:0:0.5" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <materialDesign:PackIcon Kind="TrophyOutline" Width="48" Height="48"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                                     HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="You're all caught up"
                                       Style="{DynamicResource MaterialDesignTitleMediumTextBlock}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Expander Grid.Row="1"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource MaterialDesignExpander}"
                          Visibility="{Binding HasCompletedTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="Завершенные"
                                   Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                    </Expander.Header>

                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CompletedTasks}"
                                      ItemTemplate="{StaticResource TodoItemTemplate}" Margin="0,8,0,0" />
                    </ScrollViewer>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>