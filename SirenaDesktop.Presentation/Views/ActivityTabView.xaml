<UserControl x:Class="SirenaDesktop.Views.ActivityTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SirenaDesktop.Presentation.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <converters:ProductivityToBrushConverter x:Key="ProductivityToBrushConverter" />
        <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter" />

        <Style x:Key="FadeTooltipStyle" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="HasDropShadow" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsOpen" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,40,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,32">
                <TextBlock Text="Активность за месяц"
                           Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                           FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Детальный график"
                           Style="{DynamicResource MaterialDesignBodyLargeTextBlock}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
            </StackPanel>

            <materialDesign:Card Grid.Row="1"
                                 Style="{StaticResource MaterialDesignElevatedCard}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 UniformCornerRadius="8"
                                 Padding="24"
                                 Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="{Binding MonthRangeText}"
                               Style="{DynamicResource MaterialDesignTitleMediumTextBlock}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <Border x:Name="BackgroundCard"
                            Background="{DynamicResource MaterialDesign.Brush.SurfaceContainerLow}"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Padding="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                        <StackPanel>

                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="{Binding StartDateText}"
                                           HorizontalAlignment="Left"
                                           Style="{DynamicResource MaterialDesignBodySmallTextBlock}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                                <TextBlock Text="{Binding EndDateText}"
                                           HorizontalAlignment="Right"
                                           Style="{DynamicResource MaterialDesignBodySmallTextBlock}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            Columns="{Binding ActualWidth, ElementName=BackgroundCard, Converter={StaticResource WidthToColumnsConverter}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="30"
                                                Height="30"
                                                Margin="5"
                                                CornerRadius="8"
                                                Background="{Binding ProductivityPercent, Converter={StaticResource ProductivityToBrushConverter}}"
                                                ToolTipService.InitialShowDelay="100">
                                            <Border.ToolTip>
                                                <ToolTip Style="{StaticResource FadeTooltipStyle}">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Text"
                                                                        Value="{Binding ProductivityPercent, StringFormat='Продуктивность: {0}%'}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding ProductivityPercent}"
                                                                        Value="{x:Null}">
                                                                        <Setter Property="Text"
                                                                                Value="Нет данных за этот день" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <UniformGrid Grid.Row="2" Columns="2">
                <materialDesign:Card Style="{StaticResource MaterialDesignElevatedCard}"
                                     materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8"
                                     Padding="20"
                                     Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Серия активности >60%"
                                       Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                            <TextBlock Text="{Binding CurrentStreak, StringFormat='{}{0} дн.'}"
                                       Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                                       FontSize="24" FontWeight="Black" Margin="0,6,0,0" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="Fire" Width="36" Height="36"
                                                 VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon"
                                       BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                    <Setter Property="Foreground" Value="#FF6D00" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStreak}" Value="0">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource MaterialDesignElevatedCard}"
                                     materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8"
                                     Padding="20"
                                     Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Средняя продуктивность"
                                       Style="{DynamicResource MaterialDesignBodyMediumTextBlock}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.OnSurfaceVariant}" />
                            <TextBlock Text="{Binding AverageProductivity, StringFormat='{}{0}%'}"
                                       Style="{DynamicResource MaterialDesignHeadlineMediumTextBlock}"
                                       FontSize="24" FontWeight="Black" Foreground="MediumSeaGreen" Margin="0,6,0,0" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="TrendingUp" Width="36" Height="36"
                                                 VerticalAlignment="Center" Foreground="MediumSeaGreen" />
                    </Grid>
                </materialDesign:Card>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>