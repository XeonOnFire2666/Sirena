<UserControl x:Class="SirenaDesktop.Views.HomeTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:converters="clr-namespace:SirenaDesktop.Presentation.Converters"
             xmlns:vm="clr-namespace:SirenaDesktop.ViewModels"
             xmlns:models="using:SirenaDesktop.Core.Models"
             mc:Ignorable="d"
             x:DataType="vm:HomeTabViewModel">

    <UserControl.Resources>
        <FontFamily x:Key="SourceSerifFont">
            avares://SirenaDesktop.Presentation/Fonts#Source Serif 4
        </FontFamily>
        <converters:IconTypeConverter x:Key="IconTypeConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:ProductivityToBrushConverter x:Key="ProductivityToBrushConverter" />
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBlock.sans">
            <Setter Property="FontFamily" Value="Inter" />
        </Style>

        <Style Selector="TextBlock.metric">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.5" />
        </Style>

        <Style Selector="TextBlock.metric-label">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Border.kpi оставлен: его использует hero-карточка (Classes="kpi kpi-hero").
             Две правые KPI-карточки теперь обёрнуты в Panel.card + suki:GlassCard. -->
        <Style Selector="Border.kpi">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.kpi:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="ZIndex" Value="5" />
            <Setter Property="BoxShadow" Value="0 10 24 -8 #40000000, 0 2 6 -1 #26000000" />
        </Style>

        <Style Selector="Border.kpi-hero">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="0 8 20 -6 #66000000, inset 0 1 0 0 #33FFFFFF" />
        </Style>
        <Style Selector="Border.kpi-hero:pointerover">
            <Setter Property="BoxShadow" Value="0 12 28 -8 #73000000, inset 0 1 0 0 #40FFFFFF" />
        </Style>

        <Style Selector="Border.icon-chip">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.pill-toggle">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pill-toggle:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="Button.pill-toggle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>
        <Style Selector="Button.pill-toggle.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="Button.pill-toggle.active materialIcons|MaterialIcon.pill-toggle-icon">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="Button.pill-toggle.active TextBlock.pill-toggle-label">
            <Setter Property="Opacity" Value="0.95" />
        </Style>

        <Style Selector="TextBlock.pill-toggle-label">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="materialIcons|MaterialIcon.pill-toggle-icon">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="Button.popup-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.popup-item:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
        </Style>
        <Style Selector="Button.popup-item:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="StackPanel.empty-state">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource SourceSerifFont}" />
        </Style>
        <Style Selector="Button TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SourceSerifFont}" />
        </Style>
        <Style Selector="Button TextBlock.sans">
            <Setter Property="FontFamily" Value="{StaticResource SourceSerifFont}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource SourceSerifFont}" />
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SourceSerifFont}" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,40,32,32" Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="serif"
                               Text="Activity Analysis"
                               FontSize="28" FontWeight="Bold" />
                    <TextBlock Classes="sans"
                               Text="Detailed timeline of your work for today"
                               FontSize="15"
                               Opacity="0.6" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="38" Width="156"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SukiBorderBrush}"
                        Background="{DynamicResource SukiCardBackground}"
                        VerticalAlignment="Center">
                    <CalendarDatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="12,0,8,0"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Stretch" />
                </Border>
            </Grid>

            <!-- Margin сверху даёт запас для translateY(-2px) при hover -->
            <Grid ColumnDefinitions="1.35*,*,*" ColumnSpacing="14" Margin="0,4,0,0">

                <Border Grid.Column="0" Classes="kpi kpi-hero">
                    <StackPanel Spacing="14">
                        <Border Classes="icon-chip" HorizontalAlignment="Left" Background="#33FFFFFF">
                            <materialIcons:MaterialIcon Kind="ClockOutline"
                                                        Width="18" Height="18"
                                                        Foreground="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="metric-label" Text="Total Tracked" Foreground="White" Opacity="0.85" />
                            <TextBlock Classes="metric"
                                       Text="{Binding TotalTrackedTimeStr}"
                                       FontSize="34"
                                       Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Panel Grid.Column="1" Classes="card lift">
                    <suki:GlassCard CornerRadius="16" Padding="18">
                        <StackPanel Spacing="14">
                            <Panel HorizontalAlignment="Left">
                                <Border Classes="icon-chip"
                                        Background="{Binding ProductivityPercent, Converter={StaticResource ProductivityToBrushConverter}}"
                                        Opacity="0.18" />
                                <materialIcons:MaterialIcon Kind="TrendingUp"
                                                            Width="18" Height="18"
                                                            Foreground="{Binding ProductivityPercent, Converter={StaticResource ProductivityToBrushConverter}}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Panel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="metric-label" Text="Productivity" />
                                <TextBlock Classes="metric"
                                           Text="{Binding ProductivityPercent, StringFormat='{}{0}%'}"
                                           Foreground="{Binding ProductivityPercent, Converter={StaticResource ProductivityToBrushConverter}}" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Height="4"
                                         CornerRadius="2"
                                         Value="{Binding ProductivityPercent}"
                                         Foreground="{Binding ProductivityPercent, Converter={StaticResource ProductivityToBrushConverter}}" />
                        </StackPanel>
                    </suki:GlassCard>
                    <Border Classes="rim" CornerRadius="16" />
                </Panel>

                <Panel Grid.Column="2" Classes="card lift">
                    <suki:GlassCard CornerRadius="16" Padding="18">
                        <StackPanel Spacing="14">
                            <Panel HorizontalAlignment="Left">
                                <Border Classes="icon-chip"
                                        Background="{DynamicResource SukiPrimaryColor}"
                                        Opacity="0.18" />
                                <materialIcons:MaterialIcon Kind="ApplicationOutline"
                                                            Width="18" Height="18"
                                                            Foreground="{DynamicResource SukiPrimaryColor}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Panel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="metric-label" Text="Apps / Sites" />
                                <TextBlock Classes="metric" Text="{Binding TotalUniqueApps}" />
                            </StackPanel>
                        </StackPanel>
                    </suki:GlassCard>
                    <Border Classes="rim" CornerRadius="16" />
                </Panel>
            </Grid>

            <Panel Classes="card">
                <suki:GlassCard CornerRadius="18" Padding="20,18,20,12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                            <TextBlock Grid.Column="0"
                                       Classes="serif"
                                       Text="{Binding ChartTitle}"
                                       FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Classes="pill-toggle"
                                    Command="{Binding TogglePlatformCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Classes="pill-toggle-icon" Kind="Monitor" VerticalAlignment="Center" />
                                    <TextBlock Classes="sans pill-toggle-label"
                                               Text="{Binding PlatformButtonText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid Grid.Column="2">
                                <Button x:Name="FilterButton"
                                        Classes="pill-toggle"
                                        Command="{Binding OpenFilterPopupCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Classes="pill-toggle-icon" Kind="FilterVariant" VerticalAlignment="Center" />
                                        <TextBlock Classes="sans pill-toggle-label"
                                                   Text="{Binding FilterButtonText}"
                                                   VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Classes="pill-toggle-icon" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Popup IsOpen="{Binding IsFilterPopupOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding #FilterButton}"
                                       Placement="BottomEdgeAlignedRight"
                                       IsLightDismissEnabled="True"
                                       OverlayDismissEventPassThrough="False">
                                    <suki:GlassCard CornerRadius="14" Padding="6" MinWidth="220">
                                        <Grid>
                                            <StackPanel IsVisible="{Binding !IsShowingTodoStep}" Spacing="2">
                                                <Button Content="All time"
                                                        Classes="popup-item"
                                                        Command="{Binding PickWorkspaceInPopupCommand}"
                                                        CommandParameter="{x:Null}"
                                                        Opacity="0.62" />
                                                <Separator Margin="0,4" />
                                                <ItemsControl ItemsSource="{Binding TotalWorkspaces}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:Workspace">
                                                            <Button Content="{Binding Name}"
                                                                    Classes="popup-item"
                                                                    Command="{Binding $parent[ItemsControl].((vm:HomeTabViewModel)DataContext).PickWorkspaceInPopupCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding IsShowingTodoStep}" Spacing="2">
                                                <Button Content="← Back"
                                                        Classes="popup-item"
                                                        Command="{Binding BackToWorkspaceStepCommand}" />
                                                <Separator Margin="0,4" />
                                                <ItemsControl ItemsSource="{Binding TotalTodo}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:TodoItem">
                                                            <Button Content="{Binding Title}"
                                                                    Classes="popup-item"
                                                                    Command="{Binding $parent[ItemsControl].((vm:HomeTabViewModel)DataContext).PickTodoInPopupCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </suki:GlassCard>
                                </Popup>
                            </Grid>
                        </Grid>

                        <Panel Grid.Row="1" MinHeight="300">
                            <lvc:CartesianChart Series="{Binding Pr}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                Background="Transparent"
                                                TooltipPosition="Top"
                                                TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                                TooltipTextPaint="{Binding TooltipTextPaint}"
                                                LegendPosition="Hidden"
                                                AnimationsSpeed="0:0:0.5"
                                                IsVisible="{Binding HasData}"
                                                Margin="0" Padding="0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <lvc:CartesianChart.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                                    </Transitions>
                                </lvc:CartesianChart.Transitions>
                            </lvc:CartesianChart>

                            <StackPanel Classes="empty-state"
                                        IsVisible="{Binding !HasData}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <materialIcons:MaterialIcon Kind="{Binding PlatformIcon, Converter={StaticResource IconTypeConverter}}"
                                                            Width="28"
                                                            Height="28"
                                                            Opacity="0.35"
                                                            HorizontalAlignment="Center" />
                                <TextBlock Classes="sans"
                                           Text="{Binding EmptyDataMessage}"
                                           FontSize="15"
                                           Opacity="0.45"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Grid>
                </suki:GlassCard>
                <Border Classes="rim" CornerRadius="18" />
            </Panel>

        </StackPanel>
    </ScrollViewer>
</UserControl>