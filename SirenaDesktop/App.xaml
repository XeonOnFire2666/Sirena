<Application x:Class="SirenaDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Dark"
                                                 PrimaryColor="#ff8e2d"
                                                 SecondaryColor="#4F46E5" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/SirenaDesktop.Presentation;component/Views/DialogHostOverride.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MaterialDesignFont">pack://application:,,,/Fonts/#Manrope</FontFamily>

            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="#131110" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.Surface" Color="#1C1917" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.SurfaceContainerLow" Color="#24201D" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.SurfaceContainerHigh" Color="#2D2825" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.SurfaceContainerHighest" Color="#37312D" />

            <SolidColorBrush x:Key="MaterialDesign.Brush.OutlineVariant" Color="#4A4039" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.OnSurface" Color="#F5F0EB" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.OnSurfaceVariant" Color="#BFB2A8" />

            <Style x:Key="MaterialDesignElevatedCard" TargetType="{x:Type materialDesign:Card}"
                   BasedOn="{StaticResource MaterialDesignElevatedCard}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
            </Style>

            <Style x:Key="MaterialDesignOutlinedCard" TargetType="{x:Type materialDesign:Card}"
                   BasedOn="{StaticResource MaterialDesignOutlinedCard}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.OutlineVariant}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>